def __getattr__(name: str) -> type[SchemaError]:
    if name == "SchemaError":  # validation machinery (msgspec, Hive types) is imported only when used
        from schemas.validation import SchemaError

        return SchemaError
    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")


