# Copy to .env and adjust. Everything the node needs is set here and in config.ini.

# hived image and version. Always pin a version: a new release may require a replay,
# so `latest` is deliberately not published.
HIVED_IMAGE=hiveio/hive
HIVED_VERSION=1.28.8

# How the node gets its initial state on the first start:
#
# BLOCK_LOG_URL: download the full block log (~550 GB) and replay it (1-2 days).
#   The node then has every block and can replay again later, e.g. to change the
#   tracked accounts. This is the recommended choice.
# SNAPSHOT_URL: download a state snapshot (~6 GB) and load it (minutes), then sync
#   from the snapshot's date. Only useful if the snapshot already tracks your
#   account. Alone, the node keeps no block log, so it cannot serve old blocks or
#   replay; together with BLOCK_LOG_URL it keeps the block log and only replays
#   the blocks after the snapshot.
#
# Leave both empty to sync from genesis over P2P (slowest). Both are ignored once
# the node has data.
BLOCK_LOG_URL=https://gtg.openhive.network/get/blockchain/block_log
SNAPSHOT_URL=
# SNAPSHOT_URL=https://gtg.openhive.network/get/snapshot/exchange/latest.tgz

# Ports published on the host. P2P is public so other nodes can connect to you;
# the API ports bind to localhost by default because they are not rate limited.
P2P_PORT=2001
API_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8091
WS_PORT=8090

# Extra hived command-line options for the next start, e.g. --force-replay after an
# upgrade that needs one. Clear it again afterwards.
HIVED_EXTRA_ARGS=

# The node reports healthy once its head block is at most this many seconds old.
HIVED_HEALTHCHECK_MAX_BLOCK_AGE=120

# Optional cli_wallet daemon (JSON-RPC signing service). Set COMPOSE_PROFILES=wallet
# to run it. It only accepts connections from CLI_WALLET_ALLOW_IP (0.0.0.0 = any
# address that can reach the published port, which binds to localhost by default).
COMPOSE_PROFILES=
CLI_WALLET_BIND_ADDRESS=127.0.0.1
CLI_WALLET_PORT=8093
CLI_WALLET_ALLOW_IP=0.0.0.0
